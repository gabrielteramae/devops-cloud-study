{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListLabBuckets",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::lab-devops-*"
    },
    {
      "Sid": "ReadLabObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::lab-devops-*/*"
    }
  ]
}
